<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net48</TargetFrameworks>
    <!-- RanorexOrangebeardListenerTests lives in a subfolder of this project's own directory;
         without this, the default **/*.cs glob below would also try to compile the test files
         (and the test .csproj itself) into this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);RanorexOrangebeardListenerTests\**</DefaultItemExcludes>
    <PackageId>Orangebeard.RanorexListener</PackageId>
    <Version>2.1.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>Ranorex Orangebeard Listener</Title>
    <Authors>Tom Heintzberger</Authors>
    <Description>A ReportLogger implementation to report Ranorex Test Runs to Orangebeard</Description>
    <Copyright>2025 Orangebeard.io</Copyright>
    <PackageProjectUrl>https://orangebeard.io</PackageProjectUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>beard.png</PackageIcon>
    <RepositoryUrl>https://github.com/orangebeard-io/Ranorex-Logger</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <AssemblyVersion>2.0.9</AssemblyVersion>
  </PropertyGroup>

	  
  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <!-- Prefers a real Ranorex Studio install; falls back to the repo-local rxLibs/ folder
         (untracked locally, or checked out from the private orangebeard-io/rx-libs repo in CI -
         see CLAUDE.md and .github/workflows/release.yml) when Ranorex Studio isn't installed. -->
    <Reference Include="Ranorex.Core" Condition="Exists('C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Core.dll')">
      <HintPath>C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Core.dll</HintPath>
    </Reference>
    <Reference Include="Ranorex.Libs.Util" Condition="Exists('C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Libs.Util.dll')">
      <HintPath>C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Libs.Util.dll</HintPath>
    </Reference>
    <Reference Include="Ranorex.Core" Condition="!Exists('C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Core.dll')">
      <HintPath>rxLibs\Ranorex.Core.dll</HintPath>
    </Reference>
    <Reference Include="Ranorex.Libs.Util" Condition="!Exists('C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Libs.Util.dll')">
      <HintPath>rxLibs\Ranorex.Libs.Util.dll</HintPath>
    </Reference>
	<Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Orangebeard.Client" Version="3.1.0" />
  </ItemGroup>

    <ItemGroup>
        <None Include="beard.png" Pack="true" PackagePath="\" Visible="false" />
        <None Include="LICENSE.txt" Pack="true" PackagePath="\" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>