<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>RanorexOrangebeardListener.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same Ranorex Studio installation the main project builds against - see CLAUDE.md.
         Falls back to the repo-local rxLibs/ copy (untracked - not committed, see CLAUDE.md's
         licensing note) when Ranorex Studio isn't installed on this machine. -->
    <Reference Include="Ranorex.Core" Condition="Exists('C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Core.dll')">
      <HintPath>C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Core.dll</HintPath>
    </Reference>
    <Reference Include="Ranorex.Libs.Util" Condition="Exists('C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Libs.Util.dll')">
      <HintPath>C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Libs.Util.dll</HintPath>
    </Reference>
    <Reference Include="Ranorex.Core" Condition="!Exists('C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Core.dll')">
      <HintPath>..\rxLibs\Ranorex.Core.dll</HintPath>
    </Reference>
    <Reference Include="Ranorex.Libs.Util" Condition="!Exists('C:\Program Files (x86)\Ranorex\Studio\Bin\Ranorex.Libs.Util.dll')">
      <HintPath>..\rxLibs\Ranorex.Libs.Util.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RanorexOrangebeardListener.csproj" />
  </ItemGroup>

</Project>
